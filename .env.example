# Copy to .env (never commit .env) and export the values before starting the app.
# Stable signing key for session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<generate-a-random-value>

# Optional: create the first account automatically on startup (both required,
# password at least 8 characters). Alternatively run: flask --app app create-user <name>
ACEEST_ADMIN_USERNAME=<admin-username>
ACEEST_ADMIN_PASSWORD=<choose-a-password>

# Optional: SQLite file location (default: instance/aceest.db; in Docker: /data/aceest.db)
# ACEEST_DB_PATH=/data/aceest.db

# Optional: set to 1 when served over HTTPS so the session cookie is Secure-only
# ACEEST_COOKIE_SECURE=1
